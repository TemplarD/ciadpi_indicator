# Maintainer: Templard <templard@users.noreply.github.com>
# CIADPI Indicator — системный трей для управления byedpi (ciadpi)

pkgname=ciadpi-indicator
pkgver=1.5.0
pkgrel=1
pkgdesc="System tray indicator for CIADPI/byedpi DPI bypass (RU/EN, builder, strategy search)"
arch=('any')
url="https://github.com/TemplarD/ciadpi_indicator"
license=('MIT')
depends=(
    'python'
    'python-gobject'
    'gtk3'
    'libappindicator-gtk3'
    'curl'
)
optdepends=(
    'byedpi: DPI bypass core (или соберите в ~/byedpi через скриптовый установщик)'
    'polkit: беспарольное управление сервисом'
)
makedepends=('git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/TemplarD/ciadpi_indicator/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')
install="${pkgname}.install"

package() {
    cd "${srcdir}/ciadpi_indicator-${pkgver}"

    # Модули индикатора
    local _moddir="/usr/lib/${pkgname}"
    install -d "${pkgdir}${_moddir}"
    for f in \
        ciadpi_advanced_tray.py \
        ciadpi_i18n.py \
        ciadpi_params_spec.py \
        ciadpi_texts.py \
        ciadpi_strategy_search.py \
        ciadpi_autosearch.py \
        ciadpi_param_generator.py \
        ciadpi_whitelist.py \
        diagnose_ciadpi.py
    do
        [ -f "$f" ] && install -Dm644 "$f" "${pkgdir}${_moddir}/$f"
    done

    # Исполняемые файлы
    install -Dm755 /dev/null "${pkgdir}/usr/bin/ciadpi-indicator"
    cat > "${pkgdir}/usr/bin/ciadpi-indicator" <<LAUNCHER
#!/bin/bash
export PYTHONPATH="${_moddir}\${PYTHONPATH:+:\${PYTHONPATH}}"
exec python3 ${_moddir}/ciadpi_advanced_tray.py "\$@"
LAUNCHER
    chmod +x "${pkgdir}/usr/bin/ciadpi-indicator"

    install -Dm755 ciadpi_privileges.sh "${pkgdir}/usr/bin/ciadpi-privileges-setup"

    # Диагностика
    if [ -f diagnose_ciadpi.py ]; then
        install -Dm755 diagnose_ciadpi.py "${pkgdir}/usr/bin/ciadpi-diagnose-py"
    fi

    # Desktop-запись
    install -Dm644 /dev/null "${pkgdir}/usr/share/applications/${pkgname}.desktop"
    cat > "${pkgdir}/usr/share/applications/${pkgname}.desktop" <<DESKTOP
[Desktop Entry]
Version=1.0
Type=Application
Name=CIADPI Indicator
Comment=DPI Bypass System Tray Indicator / Индикатор обхода DPI
Exec=/usr/bin/ciadpi-indicator
Icon=network-transmit-receive
Categories=Network;
StartupNotify=false
Terminal=false
X-GNOME-Autostart-enabled=true
DESKTOP

    # Лицензия и документация
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
